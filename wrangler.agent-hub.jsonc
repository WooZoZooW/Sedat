{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sedat-agent-hub-control",
  "main": "./agent-hub/worker/src/index.mjs",
  "compatibility_date": "2025-03-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "HUB", "class_name": "HubStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HubStore"] }
  ],
  "vars": {
    "AGENT_ID": "sedat-workstation",
    "AGENT_PROJECTS": "[\"sedat-site\"]"
  }
}
